<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- P2.2 / P2.5 capture. Why each one is needed and its PDPA notice: docs/permissions.md -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- P3.6: only the one-time model download (Hugging Face). No user data is sent; see docs/permissions.md -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- P5.2 morning/evening brief, asked only when the user turns one on in Settings; see docs/permissions.md -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application
    android:name=".HakuApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="Haku"
    android:supportsRtl="true"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <!-- LiteRT-LM GPU backend: Android 12+ hides vendor OpenCL from apps that don't declare it. Without these the GPU
         engine falls back to OpenGL, which fails on Adreno (Fold5: "CreateSharedMemoryManager is not implemented"). -->
    <uses-native-library android:name="libvndksupport.so" android:required="false" />
    <uses-native-library android:name="libOpenCL.so" android:required="false" />
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
      android:exported="true">
      <!-- Compose redraws on fold/unfold itself; keeping the activity keeps onboarding state and the open tab. -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- P3.5 quick note: input only, never shows diary data, so it may open over the lock screen.
         Own task (empty affinity), not in recents, so closing it never brings the app forward. -->
    <activity
      android:name=".QuickNoteActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:label="@string/quick_note_label"
      android:noHistory="true"
      android:showWhenLocked="true"
      android:taskAffinity=""
      android:theme="@style/QuickNoteTheme"
      android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    <!-- P3.5 home-screen widget; shows no diary text while the app lock is on -->
    <receiver
      android:name=".platform.widget.HakuWidget"
      android:exported="false"
      android:label="Haku">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/haku_widget_info" />
    </receiver>
    <!-- P3.5 lock-screen way in: Quick Settings tile that opens the quick note -->
    <service
      android:name=".platform.widget.QuickNoteTile"
      android:exported="true"
      android:icon="@drawable/ic_stat_haku"
      android:label="@string/quick_note_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <!-- P3.5 "จดเพิ่ม" reply on the brief notification, via our own PendingIntent only -->
    <receiver
      android:name=".platform.notify.NoteReplyReceiver"
      android:exported="false" />

    <!-- P5.8 appointments from chat notifications. Notification access is granted by the user in system settings (starts OFF);
         exported=true is required by Android so the system can bind, the BIND permission keeps every other app out.
         Reads only allowlisted chat apps, stores nothing: docs/permissions.md -->
    <service
      android:name=".platform.capture.HakuNotificationListener"
      android:exported="true"
      android:label="Haku"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <!-- P5.8 [เพิ่ม] / [ไม่ใช่] on the offer notification, via our own PendingIntent only -->
    <receiver
      android:name=".platform.notify.AppointmentOfferReceiver"
      android:exported="false" />
    <!-- P5.8 "Haku: เพิ่มนัด" in the text-selection menu. No UI of its own (translucent, finishes at once, not in recents). -->
    <activity
      android:name=".platform.capture.ProcessTextActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="Haku: เพิ่มนัด"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- Play services wake-ups (activity transitions + open-stay geofence), via our own PendingIntent only. -->
    <receiver
      android:name=".platform.capture.LocationWakeReceiver"
      android:exported="false" />
    <!-- Re-register after reboot / update; acts only if capture was started before.
         Not exported: the system still delivers BOOT_COMPLETED / MY_PACKAGE_REPLACED, other apps cannot trigger it. -->
    <receiver
      android:name=".platform.capture.BootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
